---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => post.data.visibility === 'public' && !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Boss Blog">
  <section class="mb-12">
    <h1 class="text-4xl font-bold mb-3">Hey 👋</h1>
    <p class="text-lg text-muted dark:text-muted-dark">
      Blog pribadi. Catatan, tips, dan random thoughts.
    </p>
  </section>

  <section>
    <h2 class="text-2xl font-semibold mb-6">Recent Posts</h2>
    {posts.length === 0 && (
      <p class="text-muted dark:text-muted-dark">Belum ada post. Stay tuned!</p>
    )}
    <div class="space-y-8">
      {posts.map(post => (
        <article class="group">
          <a href={`/blog/${post.id}`} class="block">
            <div class="flex items-center gap-3 mb-2">
              <time class="text-sm text-muted dark:text-muted-dark" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <div class="flex gap-1.5">
                {post.data.tags.map(tag => (
                  <span class="text-xs px-2 py-0.5 rounded-full bg-surface dark:bg-surface-dark text-muted dark:text-muted-dark">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
            <h3 class="text-xl font-semibold group-hover:text-accent transition-colors">
              {post.data.title}
            </h3>
            <p class="text-muted dark:text-muted-dark mt-1">
              {post.data.description}
            </p>
          </a>
        </article>
      ))}
    </div>
  </section>
</Layout>
