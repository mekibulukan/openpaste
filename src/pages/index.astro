---
import Layout from '../layouts/Layout.astro';
import { getAllPosts } from '../lib/posts';

const posts = (await getAllPosts())
  .filter((post) => post.visibility === 'public' && !post.draft);
---

<Layout title="Boss Blog">
  <section class="mb-12">
    <h1 class="text-4xl font-bold mb-3">Hey 👋</h1>
    <p class="text-lg text-muted dark:text-muted-dark">
      Blog pribadi. Catatan, tips, dan random thoughts.
    </p>
  </section>

  <section>
    <h2 class="text-2xl font-semibold mb-6">Recent Posts</h2>
    {posts.length === 0 && (
      <p class="text-muted dark:text-muted-dark">Belum ada post. Stay tuned!</p>
    )}
    <div class="space-y-8">
      {posts.map(post => (
        <article class="group">
          <a href={`/blog/${post.slug}`} class="block rounded-2xl p-5 -mx-5 hover:bg-surface dark:hover:bg-surface-dark transition-colors">
            <div class="flex items-center gap-3 mb-2 flex-wrap">
              <time class="text-sm text-muted dark:text-muted-dark" datetime={post.date}>
                {new Date(post.date).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <div class="flex gap-1.5 flex-wrap">
                {post.tags.map(tag => (
                  <span class="text-xs px-2 py-0.5 rounded-full bg-surface dark:bg-surface-dark text-muted dark:text-muted-dark border border-border dark:border-border-dark">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
            <h3 class="text-xl font-semibold group-hover:text-accent transition-colors">
              {post.title}
            </h3>
            <p class="text-muted dark:text-muted-dark mt-1">
              {post.description}
            </p>
          </a>
        </article>
      ))}
    </div>
  </section>
</Layout>
